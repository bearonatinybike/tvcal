[Unit]
Description=tvcal - TV airing calendar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tvcal
Group=tvcal
WorkingDirectory=/opt/tvcal
Environment=TVCAL_DB=/var/lib/tvcal/tvcal.db
Environment=TVCAL_REFRESH_HOURS=12
ExecStart=/opt/tvcal/.venv/bin/gunicorn --workers 1 --threads 4 --bind 0.0.0.0:8087 app:app
Restart=on-failure
RestartSec=5
StateDirectory=tvcal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tvcal

[Install]
WantedBy=multi-user.target
